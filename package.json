{
  "name": "fixly-target-demo-app",
  "version": "1.0.0",
  "description": "Fixly Remote Target Demo Application with Docker and Intentional Error Triggers",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "start:logging": "npm --prefix logging-server start",
    "dev:logging": "npm --prefix logging-server run dev",
    "demo:trigger": "node scripts/trigger-demo.js",
    "demo": "node scripts/demo-runner.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
